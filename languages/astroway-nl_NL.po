msgstr "Dezelfde kaart voor elke planeet die stationeert."

#: includes/views/admin-shortcodes.php:278
msgid ""
"mercury (default), venus, mars, jupiter, saturn, uranus, neptune or pluto."
msgstr ""
"mercury (standaard), venus, mars, jupiter, saturnus, uranus, neptune of "
"pluto."

