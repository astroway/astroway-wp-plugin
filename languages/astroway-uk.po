msgstr ""
"Гороскоп на поточний тиждень, починаючи з понеділка, виведений на сторінку у"
" вигляді тексту."

#: blocks/yearly-horoscope/block.json
msgctxt "block title"
msgid "Horoscope for the Year (AstroWay)"
msgstr "Гороскоп на рік (AstroWay)"

#: blocks/yearly-horoscope/block.json
