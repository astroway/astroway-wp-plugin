#: blocks/retrograde/block.json
msgctxt "block keyword"
msgid "planet"
msgstr ""

#: blocks/planet-of-day/block.json
msgctxt "block description"
msgid ""
"Traditional planetary ruler of the weekday, with its glyph and themes, "
"rendered into the page."
msgstr ""
"Vị hành tinh cai quản truyền thống của ngày trong tuần, cùng với biểu tượng "
"và các chủ đề liên quan, được thể hiện trên trang."

#: blocks/planetary-hours/block.json
msgctxt "block title"
msgid "Planetary Hours (AstroWay)"
msgstr "Giờ hành tinh (AstroWay)"

#: blocks/planetary-hours/block.json
msgctxt "block keyword"
