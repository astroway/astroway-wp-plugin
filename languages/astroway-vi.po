#: includes/class-render.php:3733
msgid "You let each other be who you are."
msgstr "Hai bạn để nhau được là chính mình."

#: includes/class-render.php:3734
msgid "You read each other's moods without words."
msgstr "Hai bạn đọc được tâm trạng của nhau không cần lời."

#: includes/class-render.php:3735
msgid "Talking comes easily and settles things."
msgstr "Trò chuyện dễ dàng và giải quyết được việc."

#: includes/class-render.php:3736
msgid "Affection and taste are shared."
msgstr "Tình cảm và sở thích được chia sẻ."

#: includes/class-render.php:3737
msgid "Desire and drive meet in the middle."
msgstr "Ham muốn và động lực gặp nhau ở giữa."

#: includes/class-render.php:3738
msgid "Promises hold and plans last."
msgstr "Lời hứa được giữ và kế hoạch bền lâu."

#: includes/class-render.php:3741
msgid "Leave each other room to be different."
msgstr "Hãy để cho nhau không gian để khác biệt."

#: includes/class-render.php:3742
msgid "Say what you feel rather than expect it to be guessed."
msgstr "Hãy nói ra cảm xúc thay vì chờ người kia đoán."

#: includes/class-render.php:3743
msgid "Check what was heard, not only what was said."
msgstr "Hãy kiểm tra điều đã được nghe, không chỉ điều đã nói."

#: includes/class-render.php:3744
msgid "Show care in the way the other one receives it."
msgstr "Hãy quan tâm theo cách người kia đón nhận."

#: includes/class-render.php:3745
msgid "Agree on pace before friction turns into a fight."
msgstr "Hãy thống nhất nhịp độ trước khi va chạm thành cãi vã."

#: includes/class-render.php:3746
msgid "Make plans explicit and keep them small at first."
msgstr "Hãy nói rõ kế hoạch và bắt đầu từ việc nhỏ."

