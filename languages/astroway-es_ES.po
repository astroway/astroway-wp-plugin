#: assets/js/astroway-blocks-editor.js:183
msgid "Numerology"
msgstr "Numerología"

#: includes/views/admin-shortcodes.php:222
msgid ""
"Life Path, Expression, Soul Urge and Personality numbers. Loads in a frame."
msgstr ""
"Números del camino de vida, de expresión, del impulso del alma y de la "
"personalidad. Se muestra en un recuadro."

