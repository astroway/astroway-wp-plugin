msgstr "Segunda persona: latitud."

#: includes/views/admin-shortcodes.php:248
msgid "Second person: longitude."
msgstr "Segunda persona: longitud."

#: includes/views/admin-shortcodes.php:249
msgid "Second person: IANA timezone."
msgstr "Segunda persona: zona horaria de la IANA."

#: includes/views/admin-shortcodes.php:250
msgid "Second person: name for the table heading."
msgstr "Segunda persona: nombre para el encabezado de la tabla."

