msgstr ""
"Primera persona: nombre para el encabezado de la tabla. Permanece en tu "
"servidor."

#: includes/views/admin-shortcodes.php:251
msgid "Second person: birth date in YYYY-MM-DD."
msgstr "Segunda persona: fecha de nacimiento en AAAA-MM-DD."

#: includes/views/admin-shortcodes.php:252
msgid "Second person: birth time in HH:MM. Optional in the same way."
msgstr ""
"Segunda persona: hora de nacimiento en HH:MM. Opcional de la misma manera."

