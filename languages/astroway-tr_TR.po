#~ msgid ""
#~ "When a visitor fills in a birth chart, compatibility, moon sign, rising sign,"
#~ " Solar Return, Lunar Return or Davison chart form, the date, time and place "
#~ "they enter are sent to api.astroway.info to calculate the answer, and the "
#~ "city name to app.astroway.info to find its coordinates. Names typed into the "
#~ "compatibility form are not sent anywhere. The AstroWay plugin does not store "
#~ "any of it on this site: the answer is not cached and the page is sent with "
#~ "no-store. Security or activity-log plugins on this site may record form "
#~ "submissions on their own."
#~ msgstr ""
#~ "Bir ziyaretçi doğum haritası, uyum, Ay burcu, yükselen burç, Güneş Dönüşü, Ay"
#~ " Dönüşü veya Davison haritası formunu doldurduğunda girdiği tarih, saat ve "
#~ "yer hesaplama için api.astroway.info adresine, şehir adı ise koordinatlarını "
#~ "bulmak için app.astroway.info adresine gönderilir. Uyum formuna yazılan adlar"
#~ " hiçbir yere gönderilmez. AstroWay eklentisi bunların hiçbirini bu sitede "
#~ "saklamaz: yanıt önbelleğe alınmaz ve sayfa no-store ile gönderilir. Bu "
#~ "sitedeki güvenlik veya etkinlik günlüğü eklentileri form gönderimlerini "
#~ "kendileri kaydedebilir."

