#: includes/views/admin-shortcodes.php:244
msgid "Second person: birth date in YYYY-MM-DD."
msgstr "İkinci kişi: Doğum tarihi YYYY-AA-GG biçiminde."

#: includes/views/admin-shortcodes.php:245
msgid "Second person: birth time in HH:MM."
msgstr "İkinci kişi: Doğum saati saat:dakika biçiminde."

#: includes/views/admin-shortcodes.php:246
msgid "Second person: latitude."
msgstr "İkinci kişi: enlem."

#: includes/views/admin-shortcodes.php:247
msgid "Second person: longitude."
msgstr "İkinci kişi: boylam."

#: includes/views/admin-shortcodes.php:248
