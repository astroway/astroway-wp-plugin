msgstr "животное"

#: blocks/chinese-zodiac/block.json
msgctxt "block description"
msgid "The Chinese animal, element and pillar of a birth date."
msgstr "Китайское животное, стихия и столп даты рождения."

#: blocks/choghadiya/block.json
msgctxt "block title"
msgid "Choghadiya (AstroWay)"
msgstr "Чогхадия (AstroWay)"

