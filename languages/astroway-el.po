msgstr "Το %1$s αρχίζει σήμερα να κινείται ανάδρομα στο %2$s."

#. translators: 1: planet name, 2: a time of day
#: includes/class-digest.php:201
#, php-format
msgid "%1$s turns direct today at %2$s."
msgstr "Το %1$s ξεκινά σήμερα απευθείας από το %2$s."

