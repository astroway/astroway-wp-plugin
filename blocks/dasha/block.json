{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/dasha",
	"title": "Vimshottari Dasha (AstroWay)",
	"category": "astroway",
	"keywords": [
		"dasha",
		"vimshottari",
		"vedic",
		"jyotish",
		"astroway"
	],
	"description": "The running Vimshottari mahadasha and antardasha with the nine sub-periods, drawn into the page; timeline adds all nine mahadashas. Needs a site key or an API key.",
	"textdomain": "astroway",
	"icon": "clock",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full",
			"center"
		],
		"customClassName": true
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"timeline": {
			"type": "string",
			"default": ""
		},
		"hide_sections": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		},
		"latitude": {
			"type": "string",
			"default": ""
		},
		"longitude": {
			"type": "string",
			"default": ""
		},
		"timezone_offset": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"astroway/look"
	],
	"editorScript": "astroway-blocks-editor"
}
