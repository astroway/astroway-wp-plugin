{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/solar-return",
	"title": "Solar Return (AstroWay)",
	"category": "astroway",
	"keywords": [
		"solar return",
		"birthday",
		"year ahead",
		"astrology",
		"astroway"
	],
	"description": "The chart of the moment the Sun returns to its birth position in a given year, drawn into the page. Without a birth date it asks the visitor. Needs a site key or an API key.",
	"textdomain": "astroway",
	"icon": "calendar-alt",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full",
			"center"
		],
		"customClassName": true
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"return_lat": {
			"type": "string",
			"default": ""
		},
		"return_lon": {
			"type": "string",
			"default": ""
		},
		"return_tz": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		},
		"latitude": {
			"type": "string",
			"default": ""
		},
		"longitude": {
			"type": "string",
			"default": ""
		},
		"timezone_offset": {
			"type": "string",
			"default": ""
		},
		"location_lat": {
			"type": "string",
			"default": ""
		},
		"location_lng": {
			"type": "string",
			"default": ""
		},
		"year": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"astroway/look"
	],
	"editorScript": "astroway-blocks-editor"
}
