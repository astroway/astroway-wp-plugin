{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/astrology-section",
	"title": "Astrology Section (AstroWay)",
	"category": "astroway",
	"keywords": [ "section", "tabs", "zodiac", "horoscope", "astroway" ],
	"description": "Sets one zodiac sign for every AstroWay block placed inside it.",
	"textdomain": "astroway",
	"icon": "screenoptions",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"customClassName": true
	},
	"attributes": {
		"sign": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"default": "stack"
		}
	},
	"providesContext": {
		"astroway/sign": "sign",
		"astroway/lang": "lang"
	},
	"editorScript": "astroway-blocks-editor"
}
