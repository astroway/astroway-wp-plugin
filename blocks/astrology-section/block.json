{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/astrology-section",
	"title": "AstroWay: Astrology Section",
	"category": "widgets",
	"description": "Sets one zodiac sign for every AstroWay block placed inside it.",
	"textdomain": "astroway",
	"icon": "screenoptions",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"customClassName": true
	},
	"attributes": {
		"sign": { "type": "string", "default": "" },
		"lang": { "type": "string", "default": "" }
	},
	"providesContext": {
		"astroway/sign": "sign",
		"astroway/lang": "lang"
	},
	"editorScript": "astroway-blocks-editor"
}
