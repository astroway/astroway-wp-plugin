{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/daily-horoscope",
	"title": "Horoscope for Today (AstroWay)",
	"category": "astroway",
	"keywords": [ "horoscope", "daily", "today", "zodiac", "astroway" ],
	"description": "Daily horoscope text for a zodiac sign.",
	"textdomain": "astroway",
	"icon": "calendar-alt",
	"supports": {
		"html": false,
		"align": [ "wide", "center" ],
		"customClassName": true
	},
	"attributes": {
		"sign": { "type": "string", "default": "" },
		"lang": { "type": "string", "default": "" }
	},
	"usesContext": [ "astroway/sign", "astroway/lang" ],
	"editorScript": "astroway-blocks-editor"
}
