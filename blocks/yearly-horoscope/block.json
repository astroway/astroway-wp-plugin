{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/yearly-horoscope",
	"title": "Horoscope for the Year (AstroWay)",
	"category": "astroway",
	"keywords": [ "horoscope", "yearly", "zodiac", "astroway" ],
	"description": "The year ahead for one zodiac sign.",
	"textdomain": "astroway",
	"icon": "calendar-alt",
	"supports": {
		"html": false,
		"align": [ "center", "wide" ],
		"customClassName": true
	},
	"usesContext": [ "astroway/sign", "astroway/lang", "astroway/look" ],
	"attributes": {
		"sign": { "type": "string", "default": "" },
		"date": { "type": "string", "default": "" },
		"lang": { "type": "string", "default": "" },
		"look": { "type": "string", "default": "" }
	},
	"editorScript": "astroway-blocks-editor"
}
