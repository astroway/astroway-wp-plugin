{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/sade-sati",
	"title": "Sade Sati (AstroWay)",
	"category": "astroway",
	"keywords": [
		"sade sati",
		"saturn",
		"shani",
		"vedic",
		"astroway"
	],
	"description": "Whether Saturn's seven and a half years over the natal Moon run now, and which phase. Without a date it asks the visitor for the birth. Needs a site key or an API key.",
	"textdomain": "astroway",
	"icon": "clock",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full",
			"center"
		],
		"customClassName": true
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"astroway/look"
	],
	"editorScript": "astroway-blocks-editor"
}
