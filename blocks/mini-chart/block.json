{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/mini-chart",
	"title": "Mini Birth Chart (AstroWay)",
	"category": "astroway",
	"keywords": [ "natal", "birth chart", "wheel", "sidebar", "astroway" ],
	"description": "The natal wheel drawn small, for a sidebar, served by api.astroway.info as a responsive iframe.",
	"textdomain": "astroway",
	"icon": "chart-pie",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"center"
		],
		"customClassName": true
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [ "astroway/look" ],
	"editorScript": "astroway-blocks-editor"
}
