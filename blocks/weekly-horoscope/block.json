{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/weekly-horoscope",
	"title": "Horoscope for the Week (AstroWay)",
	"category": "astroway",
	"keywords": [ "horoscope", "weekly", "zodiac", "astroway" ],
	"description": "Horoscope for the current week, anchored to Monday, rendered into the page as text.",
	"textdomain": "astroway",
	"icon": "calendar-alt",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"center"
		],
		"customClassName": true
	},
	"attributes": {
		"sign": {
			"type": "string",
			"default": ""
		},
		"date": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [ "astroway/sign", "astroway/lang", "astroway/look" ],
	"editorScript": "astroway-blocks-editor"
}
