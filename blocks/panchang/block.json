{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/panchang",
	"title": "AstroWay: Daily Panchang",
	"category": "widgets",
	"description": "Daily Panchang (tithi, nakshatra, yoga, karana, vara, rahu-kaal) for a date and location, served by api.astroway.info as a responsive iframe.",
	"textdomain": "astroway",
	"icon": "calendar-alt",
	"supports": {
		"html": false,
		"align": [ "wide", "center" ],
		"customClassName": true
	},
	"attributes": {
		"date":  { "type": "string", "default": "" },
		"lat":   { "type": "string", "default": "" },
		"lon":   { "type": "string", "default": "" },
		"tz":    { "type": "string", "default": "" },
		"theme": { "type": "string", "default": "" },
		"lang":  { "type": "string", "default": "" }
	},
	"editorScript": "astroway-blocks-editor"
}
