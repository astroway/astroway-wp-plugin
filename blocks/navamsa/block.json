		"time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"hide_sections": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		},
		"latitude": {
			"type": "string",
			"default": ""
		},
		"longitude": {
			"type": "string",
			"default": ""
		},
		"timezone_offset": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"astroway/look"
	],
	"editorScript": "astroway-blocks-editor"
