{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/gemstones",
	"title": "Gemstones (AstroWay)",
	"category": "astroway",
	"keywords": [
		"gemstone",
		"ratna",
		"navaratna",
		"vedic",
		"astroway"
	],
	"description": "The life, lucky and benefic stones of the chart with the day, finger, metal and weight, and the stones it advises against. Without a date it asks the visitor for the birth. Needs a site key or an API key.",
	"textdomain": "astroway",
	"icon": "star-filled",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full",
			"center"
		],
		"customClassName": true
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"astroway/look"
	],
	"editorScript": "astroway-blocks-editor"
}
