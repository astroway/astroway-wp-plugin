{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/retrograde",
	"title": "AstroWay: Retrograde Status",
	"category": "widgets",
	"description": "Whether one planet is retrograde right now, and when that changes.",
	"textdomain": "astroway",
	"icon": "undo",
	"supports": {
		"html": false,
		"align": [ "center" ],
		"customClassName": true
	},
	"attributes": {
		"planet": { "type": "string", "default": "mercury" },
		"lang": { "type": "string", "default": "" }
	},
	"editorScript": "astroway-blocks-editor"
}
