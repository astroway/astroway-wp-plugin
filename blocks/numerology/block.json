{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/numerology",
	"title": "Numerology (AstroWay)",
	"category": "astroway",
	"keywords": [ "numerology", "life path", "numbers", "astroway" ],
	"description": "Numerology core numbers (Life Path, Expression, Soul Urge, Personality) served by api.astroway.info as a responsive iframe.",
	"textdomain": "astroway",
	"icon": "editor-ol",
	"supports": {
		"html": false,
		"align": [ "wide", "center" ],
		"customClassName": true
	},
	"attributes": {
		"name":   { "type": "string", "default": "" },
		"date":   { "type": "string", "default": "" },
		"system": { "type": "string", "default": "pythagorean" },
		"theme":  { "type": "string", "default": "" },
		"lang":   { "type": "string", "default": "" },
		"look": { "type": "string", "default": "" }
	},
	"usesContext": [ "astroway/look" ],
	"editorScript": "astroway-blocks-editor"
}
