{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "astroway/moon-phase",
	"title": "Moon Phase (AstroWay)",
	"category": "astroway",
	"keywords": [ "moon", "lunar", "phase", "astroway" ],
	"description": "Current moon phase with illumination percentage.",
	"textdomain": "astroway",
	"icon": "marker",
	"supports": {
		"html": false,
		"align": [ "center" ],
		"customClassName": true
	},
	"attributes": {
		"date": { "type": "string", "default": "" },
		"lang": { "type": "string", "default": "" },
		"look": { "type": "string", "default": "" }
	},
	"usesContext": [ "astroway/look" ],
	"editorScript": "astroway-blocks-editor"
}
